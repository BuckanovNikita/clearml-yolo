# Import architecture contracts. Run: uv run lint-imports
# See docs/development.md and tests/test_architecture.py.

[importlinter]
root_packages =
    clearml_yolo
include_external_packages = true

[importlinter:contract:clean-architecture-inward-layers]
name = Clean architecture inward layers
type = layers
layers =
    clearml_yolo.entrypoints
    clearml_yolo.adapters
    clearml_yolo.application
    clearml_yolo.core

[importlinter:contract:adapters-depend-only-on-application-ports-and-contracts]
name = Adapters depend only on application ports and contracts
type = forbidden
source_modules =
    clearml_yolo.adapters
forbidden_modules =
    clearml_yolo.application.use_cases
    clearml_yolo.application.evaluation
    clearml_yolo.application.ground_truth

[importlinter:contract:application-command-composition-is-inward-and-acyclic]
name = Application command composition is inward and acyclic
type = layers
containers =
    clearml_yolo.application.use_cases
layers =
    pipeline
    val | report
    metrics
    compare | predict | train | ground_truth | export | batch_estimate
    publication

[importlinter:contract:every-command-entrypoint-stands-alone]
name = Every command entrypoint stands alone
type = independence
modules =
    clearml_yolo.entrypoints.batch_estimate
    clearml_yolo.entrypoints.compare
    clearml_yolo.entrypoints.config_tree
    clearml_yolo.entrypoints.dedup
    clearml_yolo.entrypoints.export
    clearml_yolo.entrypoints.ground_truth
    clearml_yolo.entrypoints.metrics
    clearml_yolo.entrypoints.pipeline
    clearml_yolo.entrypoints.predict
    clearml_yolo.entrypoints.report
    clearml_yolo.entrypoints.train
    clearml_yolo.entrypoints.val

[importlinter:contract:ultralytics-sdk-has-explicit-owners]
name = ultralytics SDK has explicit owners
type = forbidden
source_modules =
    clearml_yolo
forbidden_modules =
    ultralytics
allow_indirect_imports = true
ignore_imports =
    clearml_yolo.adapters.integrations.native_ddp -> ultralytics
    clearml_yolo.adapters.integrations.native_runtime -> ultralytics
    clearml_yolo.adapters.integrations.native_trainer -> ultralytics
    clearml_yolo.adapters.integrations.training -> ultralytics
    clearml_yolo.adapters.yolo.augmentation -> ultralytics
    clearml_yolo.adapters.yolo.ground_truth -> ultralytics
    clearml_yolo.adapters.yolo.inference -> ultralytics
    clearml_yolo.adapters.yolo.reinfer -> ultralytics
    clearml_yolo.adapters.yolo.batch_probe -> ultralytics
    clearml_yolo.adapters.integrations.batch_resolution -> ultralytics


[importlinter:contract:torch-sdk-has-explicit-owners]
name = torch SDK has explicit owners
type = forbidden
source_modules =
    clearml_yolo
forbidden_modules =
    torch
allow_indirect_imports = true
# Asset cache introspection loads torch.hub lazily; AST tests verify this owner.
unmatched_ignore_imports_alerting = none
ignore_imports =
    clearml_yolo.adapters.augmentation.torch_data -> torch
    clearml_yolo.adapters.yolo.augmentation -> torch
    clearml_yolo.adapters.export.positions -> torch
    clearml_yolo.adapters.export.swin -> torch
    clearml_yolo.adapters.export.tensors -> torch
    clearml_yolo.adapters.export.verification -> torch
    clearml_yolo.adapters.integrations.native_runtime -> torch
    clearml_yolo.adapters.deim.backend -> torch
    clearml_yolo.adapters.deim.probe -> torch
    clearml_yolo.adapters.rfdetr.backend -> torch
    clearml_yolo.adapters.rfdetr.probe -> torch
    clearml_yolo.adapters.export.onnx -> torch
    clearml_yolo.adapters.runtime.distributed -> torch
    clearml_yolo.adapters.runtime.gpu_memory -> torch
    clearml_yolo.adapters.integrations.training_worker -> torch
    clearml_yolo.adapters.integrations.probe_worker -> torch
    clearml_yolo.adapters.yolo.batch_probe -> torch
    clearml_yolo.adapters.torchvision.assets -> torch
    clearml_yolo.adapters.torchvision.backbone -> torch
    clearml_yolo.adapters.torchvision.checkpoint -> torch
    clearml_yolo.adapters.torchvision.data -> torch
    clearml_yolo.adapters.torchvision.distributed -> torch
    clearml_yolo.adapters.torchvision.evaluation -> torch
    clearml_yolo.adapters.torchvision.inference -> torch
    clearml_yolo.adapters.torchvision.probe -> torch
    clearml_yolo.adapters.torchvision.training -> torch
    clearml_yolo.adapters.torchvision.transform -> torch


