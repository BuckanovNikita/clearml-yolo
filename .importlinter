# Import architecture contracts. Run: uv run lint-imports
# See docs/development.md and tests/test_architecture.py.
# Contracts group identical policies; exceptions remain exact import edges.
# Forbidden contracts skip source/target self-pairs. Adapter groups preserve
# the existing storage and observability permissions without wildcard allowances.

[importlinter]
root_packages =
    clearml_yolo
include_external_packages = true

[importlinter:contract:clean-architecture-inward-layers]
name = Clean architecture inward layers
type = layers
layers =
    clearml_yolo.entrypoints
    clearml_yolo.adapters
    clearml_yolo.application
    clearml_yolo.core

[importlinter:contract:adapters-depend-only-on-application-ports-and-contracts]
name = Adapters depend only on application ports and contracts
type = forbidden
source_modules =
    clearml_yolo.adapters
forbidden_modules =
    clearml_yolo.application.use_cases
    clearml_yolo.application.evaluation
    clearml_yolo.application.ground_truth

[importlinter:contract:application-command-composition-is-inward-and-acyclic]
name = Application command composition is inward and acyclic
type = layers
containers =
    clearml_yolo.application.use_cases
layers =
    pipeline
    val | report
    metrics
    compare | predict | train | ground_truth | export | batch_estimate
    publication

[importlinter:contract:every-command-entrypoint-stands-alone]
name = Every command entrypoint stands alone
type = independence
modules =
    clearml_yolo.entrypoints.batch_estimate
    clearml_yolo.entrypoints.compare
    clearml_yolo.entrypoints.config_tree
    clearml_yolo.entrypoints.dedup
    clearml_yolo.entrypoints.download_weights
    clearml_yolo.entrypoints.export
    clearml_yolo.entrypoints.ground_truth
    clearml_yolo.entrypoints.metrics
    clearml_yolo.entrypoints.pipeline
    clearml_yolo.entrypoints.predict
    clearml_yolo.entrypoints.report
    clearml_yolo.entrypoints.train
    clearml_yolo.entrypoints.val

[importlinter:contract:sdk-ownership-lazy]
name = SDK ownership (lazy imports)
type = forbidden
source_modules =
    clearml_yolo
forbidden_modules =
    albumentations
    faster_coco_eval
    huggingface_hub
    lightning_fabric
    onnx
    pycocotools
    pytorch_lightning
    rfdetr
    tensorrt
    timm
    torch
    torchvision
    ultralytics
allow_indirect_imports = true
# Lazy imports are absent from import-linter's static graph.
unmatched_ignore_imports_alerting = none
ignore_imports =
    clearml_yolo.adapters.integrations.native_ddp -> ultralytics
    clearml_yolo.adapters.integrations.native_runtime -> ultralytics
    clearml_yolo.adapters.integrations.native_trainer -> ultralytics
