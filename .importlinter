    clearml_yolo.adapters.assets.preparation -> clearml_yolo.adapters.torchvision.assets
    clearml_yolo.adapters.assets.preparation -> clearml_yolo.adapters.rfdetr.assets
    clearml_yolo.adapters.assets.preparation -> clearml_yolo.adapters.yolo.assets

[importlinter:contract:adapter-peer-ownership-export]
name = Adapter peer ownership (export)
type = forbidden
source_modules =
    clearml_yolo.adapters.export
forbidden_modules =
    clearml_yolo.adapters.assets
    clearml_yolo.adapters.augmentation
    clearml_yolo.adapters.clearml
    clearml_yolo.adapters.deim
    clearml_yolo.adapters.evaluation
    clearml_yolo.adapters.export
    clearml_yolo.adapters.fasterrcnn
    clearml_yolo.adapters.fcos
    clearml_yolo.adapters.fiftyone
    clearml_yolo.adapters.integrations
    clearml_yolo.adapters.reporting
    clearml_yolo.adapters.rfdetr
    clearml_yolo.adapters.runtime
    clearml_yolo.adapters.storage
    clearml_yolo.adapters.torchvision
    clearml_yolo.adapters.yolo
allow_indirect_imports = true
# Lazy imports are absent from import-linter's static graph.
unmatched_ignore_imports_alerting = none
ignore_imports =
    clearml_yolo.adapters.export.build -> clearml_yolo.adapters.storage.filesystem
    clearml_yolo.adapters.export.metadata -> clearml_yolo.adapters.storage.filesystem
    clearml_yolo.adapters.export.onnx -> clearml_yolo.adapters.storage.filesystem
    clearml_yolo.adapters.export.verification -> clearml_yolo.adapters.storage.filesystem
    clearml_yolo.adapters.export.onnx -> clearml_yolo.adapters.fasterrcnn.model
    clearml_yolo.adapters.export.verification -> clearml_yolo.adapters.fasterrcnn.model
    clearml_yolo.adapters.export.verification -> clearml_yolo.adapters.storage.dataset_records

[importlinter:contract:exhaustive-root-layer-classification]
name = Exhaustive root layer classification
type = layers
containers =
    clearml_yolo
layers =
    entrypoints
    adapters
    application
    core
exhaustive = true

[importlinter:contract:exhaustive-adapter-responsibility-classification]
name = Exhaustive adapter responsibility classification
type = layers
containers =
    clearml_yolo.adapters
# Peers share a classification level; the peer contracts enforce their allowed edges.
layers =
    augmentation:storage:observability:yolo:evaluation:reporting:clearml:fiftyone:runtime:integrations:deim:rfdetr:fasterrcnn:fcos:torchvision:export:assets
exhaustive = true

[importlinter:contract:exhaustive-application-classification]
name = Exhaustive application classification
type = layers
containers =
    clearml_yolo.application
layers =
    use_cases
    evaluation | ground_truth
    ports:batch_ports
    training_workers
    contracts
exhaustive = true

[importlinter:contract:cy-never-imports-extracted-queue]
name = CY never imports extracted queue or its private dependencies
type = forbidden
source_modules =
    clearml_yolo
forbidden_modules =
    cy_queue
    textual
    pynvml
allow_indirect_imports = true

[importlinter:contract:exhaustive-entrypoint-classification]
name = Exhaustive entrypoint classification
type = layers
containers =
    clearml_yolo.entrypoints
layers =
    options:batch_estimate:batch_estimate_worker:compare:composition:config_tree:dedup:download_weights:export:ground_truth:hydra:metrics:pipeline:predict:report:train:val
exhaustive = true
